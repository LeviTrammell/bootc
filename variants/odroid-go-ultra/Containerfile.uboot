# U-Boot builder for ODROID Go Ultra (Amlogic S922X)
#
# Builds the ROCKNIX vendor U-Boot (Hardkernel v2015.01 fork) with signed FIP.
# This is the ONLY U-Boot known to boot on OGU hardware - mainline does NOT work.
#
# The FIP signing uses Amlogic vendor blobs committed in the U-Boot source tree
# (fip/g12b/), NOT LibreELEC's amlogic-boot-fip. The aml_encrypt_g12b signing
# tool is an x86_64 binary, so this MUST build on amd64.
#
# Output:
#   /u-boot.bin  - Signed FIP (write with: dd bs=512 seek=1)
#   /res/        - Splash screen BMPs for OGU display
#
# NOTE: Uses Linaro GCC 4.9.4 to match ROCKNIX's toolchain exactly.
FROM --platform=linux/amd64 docker.io/library/ubuntu:22.04 AS uboot-builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    make \
    bc \
    bison \
    flex \
    python3 \
    python-is-python3 \
    git \
    wget \
    xz-utils \
    libssl-dev \
    device-tree-compiler \
    && rm -rf /var/lib/apt/lists/*

# Download Linaro GCC 4.9.4-2017.01 toolchains (matching ROCKNIX exactly)
# aarch64-elf: for U-Boot (BL33) and main firmware
# arm-eabi: for BL301 SCP task firmware (Cortex-M3)
#
# Fallback: releases.linaro.org has outages; the Armbian mirror carries the
# same GCC 4.9.4 release but only the *-linux-gnu variants (which Hardkernel's
# own docs use for this U-Boot). Symlink the bare-metal binary names onto
# them so CROSS_COMPILE=aarch64-elf- and the FIP Makefile's hardcoded
# arm-eabi- prefix keep working either way.
RUN set -e; \
    if wget -q --timeout=30 --tries=2 https://releases.linaro.org/components/toolchain/binaries/4.9-2017.01/aarch64-elf/gcc-linaro-4.9.4-2017.01-x86_64_aarch64-elf.tar.xz && \
       wget -q --timeout=30 --tries=2 https://releases.linaro.org/components/toolchain/binaries/4.9-2017.01/arm-eabi/gcc-linaro-4.9.4-2017.01-x86_64_arm-eabi.tar.xz; then \
        tar xf gcc-linaro-4.9.4-2017.01-x86_64_aarch64-elf.tar.xz -C /opt/; \
        tar xf gcc-linaro-4.9.4-2017.01-x86_64_arm-eabi.tar.xz -C /opt/; \
        rm gcc-linaro-*.tar.xz; \
    else \
        echo "releases.linaro.org unreachable - using Armbian mirror (linux-gnu variants)"; \
        rm -f gcc-linaro-*.tar.xz; \
        wget -q https://mirrors.tuna.tsinghua.edu.cn/armbian-releases/_toolchain/gcc-linaro-4.9.4-2017.01-x86_64_aarch64-linux-gnu.tar.xz; \
        wget -q https://mirrors.tuna.tsinghua.edu.cn/armbian-releases/_toolchain/gcc-linaro-4.9.4-2017.01-x86_64_arm-linux-gnueabi.tar.xz; \
        tar xf gcc-linaro-4.9.4-2017.01-x86_64_aarch64-linux-gnu.tar.xz -C /opt/; \
        tar xf gcc-linaro-4.9.4-2017.01-x86_64_arm-linux-gnueabi.tar.xz -C /opt/; \
        rm gcc-linaro-*.tar.xz; \
        mkdir -p /opt/gcc-linaro-4.9.4-2017.01-x86_64_aarch64-elf/bin /opt/gcc-linaro-4.9.4-2017.01-x86_64_arm-eabi/bin; \
        for t in /opt/gcc-linaro-4.9.4-2017.01-x86_64_aarch64-linux-gnu/bin/aarch64-linux-gnu-*; do \
            ln -s "$t" "/opt/gcc-linaro-4.9.4-2017.01-x86_64_aarch64-elf/bin/aarch64-elf-${t##*/aarch64-linux-gnu-}"; \
        done; \
        for t in /opt/gcc-linaro-4.9.4-2017.01-x86_64_arm-linux-gnueabi/bin/arm-linux-gnueabi-*; do \
            ln -s "$t" "/opt/gcc-linaro-4.9.4-2017.01-x86_64_arm-eabi/bin/arm-eabi-${t##*/arm-linux-gnueabi-}"; \
        done; \
    fi

ENV PATH="/opt/gcc-linaro-4.9.4-2017.01-x86_64_aarch64-elf/bin:/opt/gcc-linaro-4.9.4-2017.01-x86_64_arm-eabi/bin:${PATH}"

# Clone ROCKNIX's U-Boot fork
# This is Hardkernel's vendor U-Boot with ROCKNIX patches for:
# - extlinux/sysboot support
# - mainline kernel LCD compatibility
# - fdtoverlay support
RUN git clone --depth 1 --branch odroidgoU-v2015.01 \
    https://github.com/ROCKNIX/u-boot.git /u-boot

WORKDIR /u-boot

# Ensure vendor signing tools are executable
RUN chmod +x fip/g12b/aml_encrypt_g12b fip/fip_create 2>/dev/null || true

# Build U-Boot for ODROID Go Ultra
# ARCH=arm is correct - Amlogic vendor BSP convention for U-Boot 2015.01
# The default make target builds u-boot.bin (BL33), BL301 from source,
# then runs the FIP signing/assembly via fip/Makefile
#
# IMPORTANT: CFLAGS/LDFLAGS must be set as environment variables (before make),
# NOT as make command-line arguments (after make). Make command-line variables
# cannot be overridden by Makefile assignments, which breaks the ACS firmware
# sub-make: its `CFLAGS += ${FIRMWARE_CPPFLAGS}` is silently ignored, losing
# all -I include paths and causing "asm/arch/acs.h: No such file" errors.
# ROCKNIX does it correctly: CFLAGS="" LDFLAGS="" make ...
RUN make mrproper && \
    CROSS_COMPILE=aarch64-elf- ARCH=arm CFLAGS="" LDFLAGS="" \
        make odroidgou_defconfig && \
    CROSS_COMPILE=aarch64-elf- ARCH=arm CFLAGS="" LDFLAGS="" \
        make HOSTCC="gcc" HOSTSTRIP="true" -j$(nproc)

# Verify the signed FIP was produced
# With KBUILD_OUTPUT=build, output may be in build/sd_fuse/ or sd_fuse/
RUN UBOOT_BIN="" && \
    for p in sd_fuse/u-boot.bin build/sd_fuse/u-boot.bin fip/u-boot.bin.sd.bin build/fip/u-boot.bin.sd.bin; do \
        if [ -f "$p" ]; then UBOOT_BIN="$p"; break; fi; \
    done && \
    if [ -z "${UBOOT_BIN}" ]; then \
        echo "ERROR: FIP build did not produce u-boot.bin!" && \
        echo "Checking known locations:" && \
        ls -la sd_fuse/ 2>/dev/null; \
        ls -la build/sd_fuse/ 2>/dev/null; \
        ls -la fip/ 2>/dev/null; \
        ls -la build/fip/ 2>/dev/null; \
        find . -name 'u-boot.bin*' -not -path './.git/*' 2>/dev/null; \
        exit 1; \
    fi && \
    SIZE=$(stat -c%s "${UBOOT_BIN}") && \
    echo "Found: ${UBOOT_BIN} (${SIZE} bytes, $(( SIZE / 1024 ))KB)" && \
    if [ "${SIZE}" -lt 500000 ]; then \
        echo "WARNING: FIP seems too small (${SIZE} bytes)" && exit 1; \
    else \
        echo "Verified: vendor FIP looks good"; \
    fi && \
    mkdir -p /output && cp "${UBOOT_BIN}" /output/u-boot.bin

# Collect remaining outputs
RUN mkdir -p /output/res && \
    cp -r tools/odroid_resource/res/* /output/res/ 2>/dev/null || true && \
    echo "ROCKNIX vendor U-Boot for ODROID Go Ultra" > /output/README.txt && \
    echo "Source: ROCKNIX/u-boot (odroidgoU-v2015.01)" >> /output/README.txt && \
    echo "Built: $(date)" >> /output/README.txt && \
    echo "Install: dd if=u-boot.bin of=/dev/mmcblkX bs=512 seek=1 conv=notrunc" >> /output/README.txt

# Final stage - just the outputs
FROM scratch
COPY --from=uboot-builder /output/u-boot.bin /u-boot.bin
COPY --from=uboot-builder /output/res/ /res/
COPY --from=uboot-builder /output/README.txt /README.txt
