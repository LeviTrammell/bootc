# Minimal kernel config fragment for ODROID Go Ultra (Amlogic S922X / G12B)
# Applied on top of ARM64 defconfig via scripts/kconfig/merge_config.sh
#
# Target: raw ARM64 Image under 25MB for vendor U-Boot compatibility

# ============================================================
# Platform: ONLY Amlogic Meson - disable everything else
# This is the single biggest size reduction (~15MB saved)
# ============================================================
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
CONFIG_ARCH_MESON=y
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

# CPU
CONFIG_NR_CPUS=6

# ============================================================
# Size optimizations
# ============================================================
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_KALLSYMS is not set
# CONFIG_FTRACE is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_PROFILING is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_KPROBES is not set

# Disable virtualization
# CONFIG_KVM is not set
# CONFIG_XEN is not set

# ============================================================
# Boot essentials
# ============================================================
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_VFAT_FS=y

# binfmt_misc (needed for Box64 to handle x86 child processes)
CONFIG_BINFMT_MISC=m

# ostree/bootc requirements (must be built-in)
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EROFS_FS=y

# DMA-BUF heaps (required by Mali proprietary GBM for buffer allocation)
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# ============================================================
# Amlogic Meson S922X (G12B) SoC support
# ============================================================

# Serial console (ttyAML0)
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y

# MMC/SD + eMMC
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MESON_GX=y

# Clock controllers (critical - boot hangs without these)
CONFIG_COMMON_CLK_MESON_REGMAP=y
CONFIG_COMMON_CLK_MESON_DUALDIV=y
CONFIG_COMMON_CLK_MESON_MPLL=y
CONFIG_COMMON_CLK_MESON_PHASE=y
CONFIG_COMMON_CLK_MESON_PLL=y
CONFIG_COMMON_CLK_MESON_CPU_DYNDIV=y
CONFIG_COMMON_CLK_MESON_VID_PLL_DIV=y
CONFIG_COMMON_CLK_MESON_AO_CLKC=y
CONFIG_COMMON_CLK_MESON_EE_CLKC=y
CONFIG_COMMON_CLK_MESON_G12A=y
CONFIG_COMMON_CLK_MESON_CLKC_UTILS=y
CONFIG_COMMON_CLK_MESON_VCLK=y

# Reset controller
CONFIG_RESET_MESON_COMMON=y
CONFIG_RESET_MESON=y

# Secure Monitor
CONFIG_MESON_SM=y

# Pinctrl
CONFIG_PINCTRL_MESON=y
CONFIG_PINCTRL_MESON_G12A=y

# I2C (needed for PMIC, battery gauge)
CONFIG_I2C=y
CONFIG_I2C_MESON=y

# SPI
CONFIG_SPI=y
CONFIG_SPI_MESON_SPICC=y
CONFIG_SPI_MESON_SPIFC=y

# PWM (backlight, fan)
CONFIG_PWM=y
CONFIG_PWM_MESON=y

# Watchdog
CONFIG_MESON_WATCHDOG=y

# ADC
CONFIG_MESON_SARADC=y

# Thermal
CONFIG_AMLOGIC_THERMAL=y

# Power / PMIC (RK817/RK818)
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_RTC_DRV_RK808=y
CONFIG_CHARGER_RK817=y
CONFIG_BATTERY_RK817=y

# GPIO
CONFIG_GPIO_MESON=y

# ============================================================
# Display / Graphics
# ============================================================

# DRM core
CONFIG_DRM=y
CONFIG_DRM_MESON=y
CONFIG_MESON_CANVAS=y

# MIPI DSI (OGU's display interface - added in kernel 6.10)
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_DW_MIPI_DSI=y
CONFIG_DRM_MESON_DW_MIPI_DSI=y

# HDMI (for external display debugging)
CONFIG_DRM_MESON_DW_HDMI=y

# ST7701 panel driver (OGU's 5" 854x480 MIPI DSI panel)
CONFIG_DRM_PANEL_SITRONIX_ST7701=y

# Simple framebuffer (fallback - inherit U-Boot's framebuffer)
CONFIG_DRM_SIMPLEDRM=y

# Framebuffer console
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# Backlight
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# GPU - Panfrost as module (disabled in DTB, kept for fallback)
CONFIG_DRM_PANFROST=m

# devfreq (required by mali_kbase out-of-tree module and gpu-clock service)
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_USERSPACE=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

# ============================================================
# Networking (minimal - needed for USB gadget SSH)
# ============================================================
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set

# ============================================================
# USB
# ============================================================
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_MESON_G12A=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC2=y
CONFIG_USB_GADGET=y
CONFIG_USB_ETH=m
CONFIG_USB_MASS_STORAGE=m
CONFIG_CONFIGFS_FS=y
CONFIG_USB_LIBCOMPOSITE=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_F_ECM=m

# ============================================================
# Input (gamepad, GPIO keys, joysticks, virtual input for ydotool)
# ============================================================
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ADC=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_JOYDEV=y

# ============================================================
# Sound (as modules)
# ============================================================
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_SOC=m

# ============================================================
# Disable unnecessary subsystems
# ============================================================
# CONFIG_INFINIBAND is not set
# CONFIG_PCMCIA is not set
# CONFIG_RAPIDIO is not set
# CONFIG_ACCESSIBILITY is not set
