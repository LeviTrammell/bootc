[Unit]
# Never run in root's user manager — niri-nav's own `sudo chvt` opens a
# PAM session that starts user@0, and globally-enabled units would spawn
# a rogue root instance that binds over the levi session's sockets.
ConditionUser=!@system
Description=controller-shell overlay (mode tiles + app launcher)
StartLimitIntervalSec=60
StartLimitBurst=15

[Service]
ExecStart=/usr/local/bin/controller-shell
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/1000
# Boot straight into the shell (PSP-style home screen); niri-nav's
# initial Shell mode matches.
Environment=CONTROLLER_SHELL_START_VISIBLE=1

[Install]
WantedBy=default.target
