[Unit]
Description=Generate U-Boot extlinux.conf from ostree BLS entries
# Re-asserts P1 consistency at boot; the load-bearing run is the
# shutdown-time one in update-extlinux-finalize.service.
RequiresMountsFor=/boot /boot/efi
After=boot.mount boot-efi.mount

[Service]
Type=oneshot
ExecStart=/usr/local/bin/update-extlinux.sh
StandardOutput=journal

[Install]
WantedBy=multi-user.target
